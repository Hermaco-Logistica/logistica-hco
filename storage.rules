rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isHermacoUser() {
      return request.auth != null
        && request.auth.token.email.matches('.*@hermaco[.]net');
    }

    match /solicitudes/{rfqId}/adjuntos/{archivoId} {
      allow read: if isHermacoUser();
      allow create, update: if isHermacoUser()
        && request.resource.size <= 5 * 1024 * 1024;
      allow delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
